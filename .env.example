# Mock mode for local development: no Databricks credentials required.
GENIE_AGENT_MOCK=true

# Live mode uses the app's genie-space resource (bound in databricks.yml / app.yaml):
# DATABRICKS_GENIE_AGENT_ID=your_genie_space_id
DATABRICKS_HOST=https://...
DATABRICKS_APP_PORT=8000
DATABRICKS_APP_NAME=genie-agent-app
